<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Simulador de Aviones"
        android:textSize="28sp"
        android:textStyle="bold"
        android:paddingBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtPaso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Paso: 0"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/txtColisiones"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Colisiones: 0"
            android:textSize="18sp"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escenarios"
        android:textStyle="bold"
        android:textSize="18sp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnOneCollision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="One Collision"/>

        <Button
            android:id="@+id/btnCloseEncounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Close Encounter"/>

        <Button
            android:id="@+id/btnCatastrophy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Catastrophy"/>

        <Button
            android:id="@+id/btnChain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chained Reaction"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Anterior"/>

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Siguiente"/>
    </LinearLayout>

</LinearLayout>